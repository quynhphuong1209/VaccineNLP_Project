# ============================================================================
# VaccineNLP_Web — environment configuration
# Copy to `.env` and adjust. `.env` is gitignored (never commit real secrets).
# Every variable referenced by docker-compose.yml MUST be defined here, otherwise
# docker-compose passes an empty string to the container.
# ============================================================================

# ---- PostgreSQL (db service) ----
POSTGRES_USER=vaccine_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=vaccinenlp_db

# ---- XAI engine backend (xai_service) ----
# XAI_BACKEND selects how Gemma explanations are generated:
#   lmstudio = call an external LM Studio server (local dev with GPU)
#   local    = run the bundled GGUF on CPU inside the container (self-contained)
XAI_BACKEND=lmstudio

# When XAI_BACKEND=lmstudio: where the LM Studio OpenAI-compatible API lives.
# Inside docker, the host machine is reachable via host.docker.internal.
LMSTUDIO_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=gemma-4-e4b-vaccine-xai-merged

# Optional bearer token for the LM Studio API (leave blank if not required).
LM_API_TOKEN=

# Rebuilt prompt-synced XAI cache. Docker Compose mounts this to /xai_cache/xai_cache.json.
XAI_CACHE_PATH=/xai_cache/xai_cache.json

# ---- Frontend API routing ----
# Leave VITE_API_URL empty so browsers call /api on the same origin.
# Vite uses VITE_API_PROXY_TARGET during local/dev Docker runs.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:8000

# ---- Optional crawler secrets (api_service /api/crawl-url) ----
# News crawling uses trafilatura and does not need a key.
# YouTube uses yt-dlp first; Apify is used for social sources and fallback.
APIFY_API_TOKEN=
APIFY_API_TOKEN_2=
APIFY_API_TOKEN_3=

# When XAI_BACKEND=lmstudio, set LOCAL_FALLBACK=1 to also load the GGUF as a
# Safe-Mode fallback if LM Studio is unreachable. 0 = disabled.
LOCAL_FALLBACK=0
