# ==========================================
# VaccineNLP Project .gitignore (LFS Enabled)
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.env

# --- Jupyter Notebook ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Kaggle & APIs ---
.kaggle/
.kaggle-outputs/

# --- OS & IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.streamlit/

# --- Machine Learning Models & Weights (IMPORTANT: Ignoring these to save bandwidth) ---
# We load these# Model weights and large binary files (Exclude from Git LFS to save budget)
*.bin
*.pt
*.h5
*.pth
*.ckpt
*.joblib
*.onnx
*.safetensors
experiments/models/
experiments/results/
**/checkpoint-*/
temp/*
!datasets/temp/README.md

# --- Allow all code and docs ---
!.gitignore
!.gitattributes
!README.md
!ARCHITECTURE.md
!FOLDER_STRUCTURE.md
!DOCUMENTATION_INDEX.md
!requirements.txt
!*.json
!*.md
!*.py
!*.ipynb
!*.txt
!*.sh
!*.ps1

# --- Temporary & Scratch ---
scratch/

# --- Logs, DBs & Temp Files ---
*.log
*.db
VaccineNLP_Web/api_service/test_output.txt
VaccineNLP_Web/api_service/test_output_tokenized.txt
VaccineNLP_Web/frontend/err.log
VaccineNLP_Web/frontend/out.log

