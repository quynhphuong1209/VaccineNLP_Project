# ==========================================
# VaccineNLP Project .gitignore (LFS Enabled)
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.env

# --- Jupyter Notebook ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Kaggle & APIs ---
.kaggle/
.kaggle-outputs/

# --- OS & IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Machine Learning Models & Weights (IMPORTANT: Ignoring these to save bandwidth) ---
# We load these from Hugging Face instead of Git LFS
experiments/models/
*.bin
*.pt
*.pth
*.ckpt
*.h5
*.onnx

# --- Logs & Temp ---
experiments/*/logs/
datasets/temp/*
!datasets/temp/README.md

# --- Allow all code and docs ---
!.gitignore
!.gitattributes
!README.md
!ARCHITECTURE.md
!FOLDER_STRUCTURE.md
!DOCUMENTATION_INDEX.md
!requirements.txt
!*.json
!*.md
!*.py
!*.ipynb
!*.txt
!*.sh
!*.ps1
