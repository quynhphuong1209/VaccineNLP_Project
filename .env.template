# =============================================================
# VaccineNLP — .env template
# Copy file này thành .env và điền thông tin thực
# =============================================================

# --- TikTok (không cần — dùng npm tiktok-scraper) ---
# Không cần key nào

# --- Twitter/X (không cần — dùng snscrape / Nitter) ---
# Không cần key nào

# --- Facebook (không cần — dùng Playwright) ---
# Không cần key nào
# Optional: nếu có Facebook Personal Access Token (không phải Graph API research token)
# FACEBOOK_SESSION_COOKIE=

# --- YouTube (không cần — dùng yt-dlp) ---
# Không cần key nào
# Giữ lại cho youtube_collector.py cũ nếu muốn:
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Reddit (không cần OAuth approval cho read-only) ---
# Giữ nguyên user agent
REDDIT_USER_AGENT=VaccineNLP-Thesis/2.0

# --- Apify (QUAN TRỌNG cho Social Media Collection) ---
# Lấy từ: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# --- Database (nếu dùng PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaccinenlp

# --- Paths ---
RAW_DATA_DIR=./raw_data
PROCESSED_DATA_DIR=./02_preprocessing/datasets

# --- End of Template ---
